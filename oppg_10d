import csv
import matplotlib.pyplot as plt

filnavn_oslo = r"C:oppg_10\oslo_blindern_1954_2025_med_makstemperatur.csv"
filnavn_roeros = r"C:oppg_10\roeros_1954_2025_med_makstemperatur.csv"
filnavn_tromsoe = r"C:oppg_10\tromsoe_1954_2025_med_makstemperatur.csv"
filnavn_vaernes = r"C:oppg_10\vaernes_1954_2025_med_makstemperatur.csv"
filnavn_venabu = r"C:oppg_10\venabu_1954_2025_med_makstemperatur.csv"

måneder = list(range(1, 13))

#  Oslo 
oslo = {}
for måned in måneder:
    oslo[måned] = []

with open(filnavn_oslo, encoding="utf-8") as f:
    leser = csv.reader(f, delimiter=";")
    f.readline()
    for rad in leser:
        try:
            verdi = float(rad[6].replace(",", "."))
        except ValueError:
            continue
        måned = int(rad[2].split(".")[1])
        oslo[måned].append(verdi)

oslo_min = []
oslo_med = []
oslo_maks = []
for måned in måneder:
    verdier = sorted(oslo[måned])
    n = len(verdier)
    if n % 2 == 1:
        med = verdier[n // 2]
    else:
        med = (verdier[n // 2 - 1] + verdier[n // 2]) / 2
    oslo_min.append(verdier[0])
    oslo_med.append(med)
    oslo_maks.append(verdier[-1])

